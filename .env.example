# IT Support Chatbot - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (for AI-powered responses)
GOOGLE_API_KEY=

# Flask Configuration
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASS=changeme

# LLM Configuration (optional - for external LLM)
LLM_API_KEY=
USE_LLM=false

# LINE Integration (optional)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
